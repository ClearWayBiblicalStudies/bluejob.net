{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bluejob-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "bluejob.net/api/*" },
    { "pattern": "bluejob.net/healthz" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "6ba208e725084eb882785d33396131bb"
    }
  ]
}
