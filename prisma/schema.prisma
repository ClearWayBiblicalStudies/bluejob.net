generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum EvidenceType {
  BLUEJOB_JOB
  PAYMENT
  INVOICE
  EMPLOYMENT
  LICENSE
  CERTIFICATION
  INSURANCE
  CONTRACTOR_ATTESTATION
}

enum EvidenceSource {
  BLUEJOB
  PAYMENT_PROVIDER
  PAYROLL_PROVIDER
  GOVERNMENT_REGISTRY
  INSURANCE_PROVIDER
  USER_UPLOAD
  COUNTERPARTY
}

enum JobStatus {
  DRAFT
  OPEN
  MATCHING
  AWARDED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  VIEWED
  SHORTLISTED
  DECLINED
  WITHDRAWN
  AWARDED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs      Job[]
}

model Worker {
  id              String        @id @default(cuid())
  email           String        @unique
  phone           String?
  legalName       String
  primaryTrade    String?
  identityStatus  VerificationStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  evidence        WorkEvidence[]
  scoreSnapshots  WorkScoreSnapshot[]
  bids            Bid[]
}

model WorkEvidence {
  id              String        @id @default(cuid())
  workerId        String
  worker          Worker        @relation(fields: [workerId], references: [id], onDelete: Cascade)

  type            EvidenceType
  source          EvidenceSource
  status          VerificationStatus @default(PENDING)

  externalRef     String?
  trade           String?
  monetaryValueCents Int?
  occurredAt      DateTime?
  confidence      Float         @default(0)
  metadata        Json?

  createdAt       DateTime      @default(now())
  verifiedAt      DateTime?

  @@index([workerId, status])
  @@index([externalRef])
}

model WorkScoreSnapshot {
  id               String   @id @default(cuid())
  workerId         String
  worker           Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  score            Int?
  status           String
  reliability      Int?
  completion       Int?
  experience       Int?
  repeatTrust      Int?
  compliance       Int?
  evidenceStrength Int?

  explanation      Json
  calculatedAt     DateTime @default(now())

  @@index([workerId, calculatedAt])
}

model Job {
  id                  String       @id @default(cuid())
  title               String
  description         String
  trade               String
  city                String
  state               String
  latitude            Float?
  longitude           Float?
  budgetMinCents      Int?
  budgetMaxCents      Int?
  startDate           DateTime?
  durationDays        Int?
  workersNeeded       Int?
  minimumWorkScore    Int?
  status              JobStatus    @default(DRAFT)
  organizationId      String
  organization        Organization @relation(fields: [organizationId], references: [id])
  bids                Bid[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([status])
  @@index([trade])
  @@index([city, state])
}

model Bid {
  id                String     @id @default(cuid())
  jobId             String
  job               Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  bidderId           String
  bidder             Worker     @relation(fields: [bidderId], references: [id])
  amountCents        Int
  proposedStartDate DateTime?
  estimatedDays      Int?
  message           String?
  status            BidStatus  @default(SUBMITTED)
  submittedAt       DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@unique([jobId, bidderId])
  @@index([jobId, status])
  @@index([bidderId])
}
