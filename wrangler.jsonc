{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bluejob-net",
  "main": "./worker.js",
  "compatibility_date": "2026-08-11",
  "services": [
    {
      "binding": "API",
      "service": "bluejob-api"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
